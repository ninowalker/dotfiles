#!/bin/bash -e

# Install the taps, formulae and casks recorded in OSX/Brewfile. OSX/path.zsh
# regenerates that file from what is installed.
if ! command -v brew >/dev/null; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

brew bundle install --file="$HOME/.dotfiles/OSX/Brewfile"
