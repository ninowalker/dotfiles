#!/bin/bash

# Check for required arguments
if [ "$#" -lt 1 ]; then
    echo "Usage: $0 input.pdf"
    exit 1
fi

input_pdf="$1"

# Check if pdftohtml is installed
if ! command -v pdftohtml &>/dev/null; then
    echo "Error: pdftohtml is not installed. Please install it using Homebrew:"
    echo "brew install poppler"
    exit 1
fi

# Check if pandoc is installed
if ! command -v pandoc &>/dev/null; then
    echo "Error: pandoc is not installed. Please install it using Homebrew:"
    echo "brew install pandoc"
    exit 1
fi

# Create a temporary directory and file
temp_dir=$(mktemp -d)
temp_html_dir="$temp_dir"
trap 'rm -rf "$temp_dir"; exit' INT TERM EXIT

echo "$input_pdf"
# Convert the first page of the PDF to HTML
pdftohtml -f 1 -l 1 -s "$input_pdf" "$temp_html_dir/o" &>/dev/null

temp_html="$temp_html_dir/o-html.html"

# Check if the HTML file was created
if [ ! -f "$temp_html" ]; then
    echo "Error: Failed to convert PDF to HTML." >/dev/stderr
    rm -r "$temp_dir"
    exit 1
fi

pandoc "$temp_html" -f html -t markdown
