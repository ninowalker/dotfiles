#!/bin/bash

# Name of the original volume you want to back up
SOURCE_VOLUME=$1
# Name of the new volume to store the backup
TARGET_VOLUME=$2

# Check if both volume names are provided
if [ -z "$SOURCE_VOLUME" ] || [ -z "$TARGET_VOLUME" ]; then
    echo "Usage: $0 <source_volume> <target_volume>"
    exit 1
fi

# Create the target volume if it doesn't exist
docker volume create "$TARGET_VOLUME"

# Create a temporary container to copy data from the source to the target volume
docker run --rm \
    -v "$SOURCE_VOLUME:/from" \
    -v "$TARGET_VOLUME:/to" \
    alpine ash -c "cd /from && cp -a . /to"

echo "Backup from $SOURCE_VOLUME to $TARGET_VOLUME completed. 🎉"
