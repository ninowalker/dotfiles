#!/usr/bin/env bash

# Check if a filename was provided
if [ $# -ne 1 ]; then
    echo "Usage: $0 filename"
    exit 1
fi

filename="$1"

# Check if the file exists
if [ ! -e "$filename" ]; then
    echo "Error: File '$filename' does not exist."
    exit 1
fi

# Read tags from stdin into an array
mapfile -t tags

# Initialize a flag to indicate whether the file was moved
file_moved=0

# Iterate over each tag in order
for tag in "${tags[@]}"; do
    # Trim leading and trailing whitespace from tag
    tag=$(echo "$tag" | xargs)
    # Skip empty tags
    if [ -z "$tag" ]; then
        continue
    fi
    # Check if the directory exists
    if [ -d "$tag" ]; then
        echo "Moving '$filename' into directory '$tag'"
        mv "$filename" "$tag/"
        file_moved=1
        break # Exit the loop after moving the file
    fi
done

if [ $file_moved -eq 0 ]; then
    echo "No matching directories found for the provided tags." >/dev/stderr
    exit 1
fi
